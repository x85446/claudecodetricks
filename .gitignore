# Binaries
/plugins/*/hooks/*
!/plugins/*/hooks/.gitkeep
/bin/*
!/bin/.gitkeep

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
go.work

# Test coverage
coverage.out
coverage.html

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Env
.env
.env.local

# Warden local configuration
.warden.local/
.warden/.env
.warden.bak/
.warden/warden-cellserver
temp/

# Rust (skills-tui)
skills-tui/target/

# Codex port bookkeeping — regenerated by sync-all.sh
codex-skills/*/.portstamp

# Python bytecode from the Codex sync scripts
__pycache__/

# Live iterate plans are per-machine state (one session's run in flight);
# archived plans under .claude/iterate/archive/ are the record and stay tracked.
.claude/iterate/plans/
# Mailbox messages are local state too; /mailbox never commits them.
.claude/iterate/inbox/
.claude/iterate/sent/
