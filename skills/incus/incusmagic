# Short alias resolver (Bash 3.2 compatible - no associative arrays)
_resolve_noun_alias() {
    case "$1" in
        c)    echo "container" ;;
        p)    echo "profile" ;;
        net)  echo "network" ;;
        img)  echo "image" ;;
        l)    echo "launch" ;;
        ls)   echo "list" ;;
        b)    echo "backup" ;;
        st)   echo "storage" ;;
        d)    echo "diag" ;;
        r)    echo "report" ;;
        rem)  echo "remote" ;;
        cust) echo "customization" ;;
        *)    echo "" ;;
    esac
}

# Reverse lookup: noun -> alias
_get_noun_alias() {
    case "$1" in
        container)     echo "c" ;;
        profile)       echo "p" ;;
        network)       echo "net" ;;
        image)         echo "img" ;;
        launch)        echo "l" ;;
        list)          echo "ls" ;;
        backup)        echo "b" ;;
        storage)       echo "st" ;;
        diag)          echo "d" ;;
        report)        echo "r" ;;
        remote)        echo "rem" ;;
        customization) echo "cust" ;;
        *)             echo "" ;;
    esac
}

_show_help() {
    echo "${BOLD}incusmagic${NORM} v${VERSION} - Incus host management CLI"
    echo ""
    echo "Usage: ${PROG} [--project NAME] <command> [subcommand] [options] [args...]"
    echo "       im      [--project NAME] <command> [subcommand] [options] [args...]"
    echo ""
    echo "${BOLD}Global options:${NORM}"
    echo "  --project NAME, -P NAME   Scope incus operations to the named project"
    echo "                            (also picked up from \$INCUS_PROJECT;"
    echo "                            auto-detected when a target container is"
    echo "                            found in a non-default project)"
    echo ""
    echo "${BOLD}Commands:${NORM}"
    echo ""

    local current_noun=""
    for entry in "${_CMD_REGISTRY[@]}"; do
        local cmd="${entry%%|*}"
        local desc="${entry##*|}"
        local noun="${cmd%% *}"
        local verb="${cmd#* }"
        [[ "${verb}" == "${noun}" ]] && verb=""

        if [[ "${noun}" != "${current_noun}" ]]; then
            [[ -n "${current_noun}" ]] && echo ""
            current_noun="${noun}"
            local alias_str=""
            local _alias
            _alias=$(_get_noun_alias "${noun}")
            [[ -n "${_alias}" ]] && alias_str=" (${_alias})"
            echo "  ${BOLD}${noun}${NORM}${alias_str}"
        fi
        if [[ -n "${verb}" ]]; then
            printf "    %-22s %s\n" "${verb}" "${desc}"
        else
            printf "    %-22s %s\n" "(default)" "${desc}"
        fi
    done
    echo ""
    echo "Run '${PROG} help <command>' for details on a specific command."
}

_show_subcommand_help() {
    local target="$1"
    # Resolve alias
    local _resolved
    _resolved=$(_resolve_noun_alias "${target}")
    [[ -n "${_resolved}" ]] && target="${_resolved}"
    local found=false
    echo "${BOLD}${target}${NORM} commands:"
    echo ""
    for entry in "${_CMD_REGISTRY[@]}"; do
        local cmd="${entry%%|*}"
        local desc="${entry##*|}"
        local noun="${cmd%% *}"
        local verb="${cmd#* }"
        [[ "${verb}" == "${noun}" ]] && verb=""
        if [[ "${noun}" == "${target}" ]]; then
            found=true
            if [[ -n "${verb}" ]]; then
                printf "  %-24s %s\n" "${PROG} ${noun} ${verb}" "${desc}"
            else
                printf "  %-24s %s\n" "${PROG} ${noun}" "${desc}"
            fi
        fi
    done
    if ! $found; then
        echo "Unknown command: ${target}" >&2
        return 1
    fi
}

