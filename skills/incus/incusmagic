        case "$1" in
            -h|--help)
                echo "Usage: ${PROG} history [--ignoreProject proj1,proj2,...] [username]"
                echo ""
                echo "Show a table of all instances (running and stopped) and the user who"
                echo "created each one. Creator data is pulled from Loki lifecycle events."
                echo "Instances created before Loki was enabled show as 'unk-before-loging'."
                echo ""
                echo "Args:"
                echo "  username                    Optional. Show only instances by this user."
                echo ""
                echo "Options:"
                echo "  --ignoreProject p1,p2,...   Hide instances in these projects (csv)."
                echo ""
                echo "Env:"
                echo "  LOKI_ADDR              Loki HTTP endpoint (e.g. http://10.7.112.252:3100)"
                echo "  LOKI_HISTORY_SINCE     Lookback window (default: 720h)"
                return 0
                ;;
            --ignoreProject=*) ignore_projects_csv="${1#--ignoreProject=}"; shift ;;
            --ignoreProject)
                [[ $# -ge 2 ]] || _die "--ignoreProject requires a value"
                ignore_projects_csv="$2"; shift 2 ;;
            -*) _die "Unknown option: $1. See: ${PROG} history --help" ;;
            *)  user_filter="$1"; shift ;;
        esac
    done

    # Build associative set of projects to skip.
    declare -A skip_project
    if [[ -n "${ignore_projects_csv}" ]]; then
        local IFS=','
        local p
        for p in ${ignore_projects_csv}; do
            [[ -n "${p}" ]] && skip_project["${p}"]=1
        done
    fi

    command -v logcli >/dev/null 2>&1 || _die "logcli is required for history (https://github.com/grafana/loki/releases). On Incus hosts it lives at /usr/local/bin/logcli."
    command -v jq     >/dev/null 2>&1 || _die "jq is required for history. Install: apt-get install -y jq"
    [[ -n "${LOKI_ADDR:-}" ]] || _die "LOKI_ADDR not set. Try: source /etc/profile.d/loki.sh"
    curl -fsS --max-time 5 "${LOKI_ADDR}/ready" >/dev/null 2>&1 \
        || _die "Loki not reachable at ${LOKI_ADDR}"

    local since="${LOKI_HISTORY_SINCE:-720h}"

    # Build map: project/name -> user, from Loki "instance-created" events.
    declare -A name_to_user
    local line src proj name user key
    while IFS= read -r line; do
        [[ -z "${line}" ]] && continue
        src=$(printf '%s' "${line}" | grep -oE 'source="/1\.0/instances/[^"]+"' | head -1)
        [[ -z "${src}" ]] && continue
        src="${src#source=\"}"; src="${src%\"}"
        proj="default"
        if [[ "${src}" == *"?project="* ]]; then
            proj="${src##*\?project=}"
            proj="${proj%%&*}"
            src="${src%%\?*}"
        fi
        name="${src##*/}"
        user=$(printf '%s' "${line}" | grep -oE 'requester-username="[^"]+"' | head -1)
        user="${user#requester-username=\"}"; user="${user%\"}"
        [[ -z "${name}" || -z "${user}" ]] && continue
        key="${proj}/${name}"
        # Don't overwrite; logcli returns newest first by default, so the first
        # creation event we see for a (project,name) pair is the most recent
        # creator -- which is what we want if a name was recreated.
        [[ -z "${name_to_user[${key}]:-}" ]] && name_to_user["${key}"]="${user}"
    done < <(logcli query "{app=\"incus\"} |~ \"action=\\\"instance-created\\\"\"" \
                --since="${since}" --limit=10000 --quiet -o raw 2>/dev/null)

    # Pull all instances across all projects and resolve creator.
    local iname iproj istate itype iloc
    local -a rows=()
    while IFS=$'\t' read -r iname iproj istate itype iloc; do
        [[ -z "${iname}" ]] && continue
        [[ -n "${skip_project[${iproj}]:-}" ]] && continue
        local creator="${name_to_user[${iproj}/${iname}]:-unk-before-loging}"
        if [[ -z "${user_filter}" || "${creator}" == "${user_filter}" ]]; then
            rows+=("$(printf '%s\t%s\t%s\t%s\t%s' "${iname}" "${creator}" "${iproj}" "${istate}" "${iloc}")")
        fi
    done < <(incus list --all-projects --format json 2>/dev/null \
             | jq -r '.[] | [.name, .project, .status, .type, .location] | @tsv')

    if [[ ${#rows[@]} -eq 0 ]]; then
        if [[ -n "${user_filter}" ]]; then
            echo "No instances found for user: ${user_filter}"
        else
            echo "No instances found."
        fi
        return 0
    fi

    {
        printf 'INSTANCE\tUSER\tPROJECT\tSTATE\tLOCATION\n'
        printf '%s\n' "${rows[@]}" | LC_ALL=C sort
    } | column -t -s $'\t'
}

