# ---- ssh ----

_cmd_ssh_enable() {
    # Source user config for key paths
    [[ -f "${HOME}/.usermagic" ]] && source "${HOME}/.usermagic"
    local tempfile
    tempfile=$(mktemp)

    local newkey=0 portfwd="false" passwordlessSudo=1 proxyjump=1 SAVETO=""

    OPTIND=1
    while getopts "hnp:jsS:" opt; do
        case "${opt}" in
            h)
                echo -e "${BOLD}${UND}Usage:${NORM} ${PROG} ssh enable [options] <container> <username>"
                echo ""
                echo -e "${BOLD}${UND}Options:${NORM}"
                echo "  -h  Show this help"
                echo "  -n  Generate a new SSH key (vs using existing)"
                echo "  -p PORT  Forward port from host to container for SSH"
                echo "  -j  Disable proxyjump"
                echo "  -s  Disable passwordless sudo"
                echo "  -S FILE  Save SSH config entry to file"
                echo ""
                echo -e "${BOLD}${UND}Examples:${NORM}"
                echo "  ${PROG} ssh enable mycontainer bob"
                echo "  ${PROG} ssh enable -n -p 22455 mycontainer sue"
                return 0
                ;;
            n) newkey=1 ;;
            p) portfwd="${OPTARG}" ;;
            j) proxyjump=0 ;;
            s) passwordlessSudo=0 ;;
            S) SAVETO="${OPTARG}" ;;
            \?)
                echo "Option -${OPTARG} not allowed." >&2
                return 1
                ;;
        esac
    done
    shift $((OPTIND - 1))

    if [[ $# -ne 2 ]]; then
        echo "Usage: ${PROG} ssh enable [options] <container> <username>" >&2
        rm -f "${tempfile}"
        return 1
    fi

    # Accept "remote:name" or bare "name" (with INCUS_REMOTE default applied).
    # CONTAINER_TARGET is always the fully-qualified form for `incus ...` calls.
    # CONTAINER_NAME is the bare name (used for ssh Host alias, key file names,
    # display strings, etc.).
    local CONTAINER_INPUT="$1"
    local CONTAINER_TARGET; CONTAINER_TARGET="$(_apply_remote "$1")"
    local CONTAINER_NAME="${CONTAINER_TARGET##*:}"
    local user="$2"
    local scpNewKey="" sshkeyoutput=""

    if ! _is_container "${CONTAINER_TARGET}"; then
        echo "${CONTAINER_TARGET} is not a container" >&2
        rm -f "${tempfile}"
        return 1
    fi

    local keys="" idFile=""
    if [[ ${newkey} -eq 0 && -f "${newMachinePublicKey:-/nonexistent}" ]]; then
        echo "Using keys referenced in ${HOME}/.usermagic"
        keys=$(cat "${newMachinePublicKey}")
        idFile="${newMachinePrivateKeyName}"
    elif [[ ${newkey} -eq 0 && -f "${HOME}/.ssh/to_${HOSTNAME}" ]]; then
        echo "Using the to_${HOSTNAME} key found in .ssh"
        keys=$(cat ~/.ssh/authorized_keys)
        idFile="to_${HOSTNAME}"
    elif [[ ${newkey} -eq 0 && -f "${HOME}/.ssh/to_generic.pub" ]]; then
        echo "Using the to_generic key found in .ssh"
        keys=$(cat "${HOME}/.ssh/to_generic.pub")
        idFile="to_generic"
    else
        if [[ ${newkey} -eq 0 ]]; then
            echo "Cannot find existing key, generating a new one"
        fi
        rm -f "${HOME}/.ssh/to_${CONTAINER_NAME}_${user}" "${HOME}/.ssh/to_${CONTAINER_NAME}_${user}.pub"
        ssh-keygen -o -t ED25519 -b 4096 -C "${user}_${CONTAINER_NAME}_on_${HOSTNAME}" -N "" -f "${HOME}/.ssh/to_${CONTAINER_NAME}_${user}"
        keys=$(cat "${HOME}/.ssh/to_${CONTAINER_NAME}_${user}.pub")
        idFile="to_${CONTAINER_NAME}_${user}"
        sshkeyoutput=$(
            echo "Your ${BOLD}ssh private key${NORM} is at ${HOME}/.ssh/to_${CONTAINER_NAME}_${user}"
            echo "Your ${BOLD}ssh public key${NORM}  is at ${HOME}/.ssh/to_${CONTAINER_NAME}_${user}.pub"
            echo "---------------------------------------------------------------------------------------------"
            echo "${CYAN}scp ${HOSTNAME}:~/.ssh/to_${CONTAINER_NAME}_${user}* ~/.ssh/${NORM}"
            echo "---------------------------------------------------------------------------------------------"
        )
        scpNewKey="scp ${HOSTNAME}:~/.ssh/to_${CONTAINER_NAME}_${user}* ~/.ssh/ ;"
    fi

    local useIP port
    if [[ "${portfwd}" != "false" ]]; then
        if [[ "${CONTAINER_TARGET}" == *:* ]]; then
            echo "${YELLOW}Warning:${NORM} -p (port forward) on a remote container (${CONTAINER_TARGET}) forwards to the remote host's interface, not this machine. Reachability from here depends on the network." >&2
        fi
        incus config device add "${CONTAINER_TARGET}" proxyport"${portfwd}" proxy listen=tcp:0.0.0.0:"${portfwd}" connect=tcp:127.0.0.1:22
        if [[ $? -ne 0 ]]; then
            echo "${RED}Error${NORM} creating port forward. Make sure you're using a unique port."
            echo "${CYAN}netstat -tulpn | grep ${portfwd}${NORM}"
            netstat -tulpn | grep "${portfwd}" || true
            echo "Aborting..."
            rm -f "${tempfile}"
            return 1
        fi
        port="${portfwd}"
        useIP=$(ip addr show | grep 'inet ' | grep -v 127.0.0.1 | awk '{print $2}' | cut -d'/' -f1 | head -1)
    else
        useIP=$(incus list -c 4 -f csv "${CONTAINER_TARGET}" | grep -v docker | grep -v iibr | head -1 | awk '{print $1}' | cut -d '"' -f2)
        port=22
    fi

    # Install SSH in the container
    local thisPM
    thisPM=$(_get_package_manager "${CONTAINER_TARGET}")
    case "${thisPM}" in
        apt)
            _remote_install "${CONTAINER_TARGET}" "${thisPM}" "ssh"
            _remote_start "${CONTAINER_TARGET}" "${thisPM}" "ssh"
            ;;
        yum|dnf)
            _remote_install "${CONTAINER_TARGET}" "${thisPM}" "openssh-server"
            _remote_start "${CONTAINER_TARGET}" "${thisPM}" "sshd"
            ;;
        zypper|pacman)
            _remote_install "${CONTAINER_TARGET}" "${thisPM}" "openssh"
            _remote_start "${CONTAINER_TARGET}" "${thisPM}" "sshd"
            ;;
    esac

    # Set up authorized_keys
    if [[ "${user}" == "root" ]]; then
        incus exec "${CONTAINER_TARGET}" -- bash -c "
            mkdir -p /root/.ssh && chmod 700 /root/.ssh
            touch /root/.ssh/authorized_keys && chmod 600 /root/.ssh/authorized_keys
            echo '${keys}' >> /root/.ssh/authorized_keys
            chown -R root:root /root/
        "
    else
        incus exec "${CONTAINER_TARGET}" -- bash -c "
            if ! id -u ${user} >/dev/null 2>&1; then
                useradd ${user} -m -G sudo -s /bin/bash
                echo '${user}:${user}123' | chpasswd
            fi
            mkdir -p /home/${user}/.ssh && chmod 700 /home/${user}/.ssh
            touch /home/${user}/.ssh/authorized_keys && chmod 600 /home/${user}/.ssh/authorized_keys
            echo '${keys}' >> /home/${user}/.ssh/authorized_keys
            chown -R ${user}:${user} /home/${user}/
        "
    fi

    # Results
    figlet RESULTS 2>/dev/null || echo "=== RESULTS ==="
    [[ -n "${sshkeyoutput}" ]] && echo "${sshkeyoutput}"

    local PJUMP=""
    if [[ ${proxyjump} -eq 1 && -n "${jumphost:-}" ]]; then
        PJUMP="    proxyjump ${jumphost}"
    fi

    # Build the SSH config block
    local config_block=""
    config_block+="Host ${CONTAINER_NAME}"$'\n'
    config_block+="    user ${user}"$'\n'
    config_block+="    hostname ${useIP}"$'\n'
    config_block+="    port ${port}"$'\n'
    config_block+="    identityfile ~/.ssh/${idFile}"$'\n'
    config_block+="    stricthostkeychecking no"$'\n'
    config_block+="    userknownhostsfile /dev/null"$'\n'
    config_block+="    serveraliveinterval 200"$'\n'
    config_block+="    identitiesonly yes"$'\n'
    config_block+="    passwordauthentication no"$'\n'
    config_block+="    forwardagent yes"
    [[ -n "${PJUMP}" ]] && config_block+=$'\n'"${PJUMP}"

    echo "${config_block}" > "${tempfile}"

    # Auto-append to ~/.ssh/config
    local ssh_config="${HOME}/.ssh/config"
    mkdir -p "${HOME}/.ssh"
    chmod 700 "${HOME}/.ssh"
    touch "${ssh_config}"
    chmod 600 "${ssh_config}"

    # Remove existing block for this Host if present, then append new one
    if grep -q "^Host ${CONTAINER_NAME}$" "${ssh_config}" 2>/dev/null; then
        echo "${YELLOW}Replacing existing '${CONTAINER_NAME}' entry in ${ssh_config}${NORM}"
        # Remove old block: from "Host <name>" to the line before the next "Host " or EOF
        local tmp_cfg
        tmp_cfg=$(mktemp)
        awk -v host="Host ${CONTAINER_NAME}" '
            BEGIN { skip=0 }
            /^Host / {
                if ($0 == host) { skip=1; next }
                else { skip=0 }
            }
            !skip { print }
        ' "${ssh_config}" > "${tmp_cfg}"
        cp "${tmp_cfg}" "${ssh_config}"
        rm -f "${tmp_cfg}"
    fi

    # Ensure a blank line before the new entry
    if [[ -s "${ssh_config}" ]] && [[ "$(tail -c 1 "${ssh_config}")" != "" ]]; then
        echo "" >> "${ssh_config}"
    fi
    echo "${config_block}" >> "${ssh_config}"
    echo "${GREEN}Appended to ${ssh_config}${NORM}"

    # Display what was written
    echo "---------------------------------------------------------------------------------------------"
    echo "${config_block}"
    echo "---------------------------------------------------------------------------------------------"

    if [[ -n "${SAVETO}" ]]; then
        cp "${tempfile}" "${SAVETO}"
        echo "SSH config also saved to ${SAVETO}"
    fi

    if command -v storm &>/dev/null; then
        echo ""
        echo "Storm command:"
        echo "---------------------------------------------------------------------------------------------"
        echo "${CYAN}${scpNewKey} storm delete ${CONTAINER_NAME};storm add ${CONTAINER_NAME} ${user}@${useIP}:${port} --id_file ~/.ssh/${idFile} --o \"StrictHostKeyChecking=no\" --o \"UserKnownHostsFile=/dev/null\" --o \"ServerAliveInterval=200\" --o \"IdentitiesOnly=yes\" --o \"passwordauthentication=no\" --o \"forwardagent=yes\"${NORM}"
        echo "---------------------------------------------------------------------------------------------"
    fi

    echo "You should now be able to: ${CYAN}ssh ${CONTAINER_NAME}${NORM}"
    if [[ "${user}" != "root" ]]; then
        echo "${RED}NOTE: sudo password is:${NORM} ${user}123"
    fi

    if [[ ${passwordlessSudo} -eq 1 ]]; then
        incus exec "${CONTAINER_TARGET}" -- bash -c "echo '${user} ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/${user} && chmod 0440 /etc/sudoers.d/${user}"
    fi

    rm -f "${tempfile}"
}

# ---- storage ----

_cmd_storage_move() {
    _need_args 2 $# "storage move <pool> <container...>" || return 1
    local new_storage_pool="$1"; shift
    # Validate pool exists
    if ! incus storage list -f csv 2>/dev/null | grep -q "${new_storage_pool}"; then
        _die "${new_storage_pool} does not exist."
    fi
    for container_arg in "$@"; do
        local container_target container_name
        container_target="$(_apply_remote "${container_arg}")"
        container_name="${container_target##*:}"
        local uniq
        uniq=$(cat /dev/urandom | tr -dc 'a-zA-Z0-9' | fold -w 5 | head -n 1)
        _run "incus list -c ens46PbtlL ${container_target} --all-projects"
        local old_pool
        old_pool=$(incus list "${container_target}" -c b -f csv)
        local old_profile new_profile
        if [[ "${old_pool}" == "default" ]]; then
            old_profile="disk-generic"
        else
            old_profile="${old_pool}"
        fi
        if [[ "${new_storage_pool}" == "default" ]]; then
            new_profile="disk-generic"
        else
            new_profile="${new_storage_pool}"
        fi
        # For incus move target naming: when a remote is in play, the temp/new
        # names stay within the same remote — only the bare name part changes.
        local rp=""
        [[ "${container_target}" == *:* ]] && rp="${container_target%%:*}:"
        local temp_target="${rp}${container_name}-${uniq}"
        echo "${YELLOW}Moving ${container_target} to storage pool ${new_storage_pool} (temp: ${temp_target})${NORM}"
        incus stop "${container_target}"
        incus move "${container_target}" "${temp_target}" -s "${new_storage_pool}"
        incus move "${temp_target}" "${container_target}"
        incus profile add "${container_target}" "${new_profile}"
        incus profile remove "${container_target}" "${old_profile}"
        incus start "${container_target}"
        _run "incus list -c ens46PbtlL ${container_target} --all-projects"
    done
}

