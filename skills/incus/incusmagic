    local target; target="$(_apply_remote "t1")"
    _run "incus launch images:ubuntu/24.04 ${target} --profile default"
}

# ---- launch wizard (interactive) ----

readonly SCRIPTS_DIR="${HOME}/.local/share/incusmagic"

# Prompt user to pick from a numbered list. Sets _PICK to the chosen value.
# Usage: _pick "Prompt" "option1" "option2" ...
_pick() {
    local prompt="$1"; shift
    local options=("$@")
    echo ""
    echo "${BOLD}${prompt}${NORM}"
    local i=1
    for opt in "${options[@]}"; do
        echo "  ${CYAN}${i})${NORM} ${opt}"
        i=$(( i + 1 ))
    done
    while true; do
        echo -n "${YELLOW}> ${NORM}"
        read -r choice || true
        if [[ "${choice}" =~ ^[0-9]+$ ]] && [[ "${choice}" -ge 1 ]] && [[ "${choice}" -le ${#options[@]} ]]; then
            _PICK="${options[$(( choice - 1 ))]}"
            return 0
        fi
        echo "  Invalid choice. Enter 1-${#options[@]}."
    done
}

# Prompt for free-text input with a default. Sets _INPUT to the value.
# Usage: _prompt "Prompt" "default"
_prompt() {
    local prompt="$1"
    local default="${2:-}"
    echo ""
    if [[ -n "${default}" ]]; then
        echo -n "${BOLD}${prompt}${NORM} [${default}]: "
    else
        echo -n "${BOLD}${prompt}${NORM}: "
    fi
    read -r _INPUT || true
    if [[ -z "${_INPUT}" ]]; then
        _INPUT="${default}"
    fi
}

# Multi-select from a list. Sets _PICKS array to chosen values.
# Usage: _pick_multi "Prompt" "option1" "option2" ...
_pick_multi() {
    local prompt="$1"; shift
    local options=("$@")
    _PICKS=()
    if [[ ${#options[@]} -eq 0 ]]; then return 0; fi
    echo ""
    echo "${BOLD}${prompt}${NORM}"
    local i=1
    for opt in "${options[@]}"; do
        echo "  ${CYAN}${i})${NORM} ${opt}"
        i=$(( i + 1 ))
    done
    echo "  ${CYAN}0)${NORM} (none)"
    echo ""
    echo "Enter numbers separated by spaces, or 0 for none:"
    echo -n "${YELLOW}> ${NORM}"
    read -r choices || true
    if [[ "${choices}" == "0" || -z "${choices}" ]]; then return 0; fi
    for c in ${choices}; do
        if [[ "${c}" =~ ^[0-9]+$ ]] && [[ "${c}" -ge 1 ]] && [[ "${c}" -le ${#options[@]} ]]; then
            _PICKS+=("${options[$(( c - 1 ))]}")
        fi
    done
}

_cmd_launch_wizard() {
    # --- Parse CLI flags (skip interactive prompts when provided) ---
    local _arg_image="" _arg_name="" _arg_type="" _arg_desktop="" _arg_memory=""
    local _arg_cpus="" _arg_disk="" _arg_user="" _arg_scripts="" _arg_yes=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --image)   _arg_image="$2";   shift 2 ;;
            --name)    _arg_name="$2";    shift 2 ;;
            --type)    _arg_type="$2";    shift 2 ;;
            --desktop) _arg_desktop="$2"; shift 2 ;;
            --memory)  _arg_memory="$2";  shift 2 ;;
            --cpus)    _arg_cpus="$2";    shift 2 ;;
            --disk)    _arg_disk="$2";    shift 2 ;;
            --user)    _arg_user="$2";    shift 2 ;;
            --scripts) _arg_scripts="$2"; shift 2 ;;
            -y|--yes)  _arg_yes="yes";    shift ;;
            *)         _die "Unknown flag: $1" ;;
        esac
    done

    echo "${BOLD}=== incusmagic launch wizard v${VERSION} ===${NORM}"

    # --- 1. OS Image ---
    local image_base=""
    if [[ -n "${_arg_image}" ]]; then
        image_base="${_arg_image}"
    else
        _pick "Choose OS image:" "Ubuntu 24.04 (u24)" "Ubuntu 22.04 (u22)"
        case "${_PICK}" in
            *u24*) image_base="ubuntu/24.04" ;;
            *u22*) image_base="ubuntu/22.04" ;;
        esac
    fi

    # --- 2. Desktop environment ---
    local image="${image_base}"
    local install_desktop="no"
    if [[ -n "${_arg_desktop}" ]]; then
        install_desktop="${_arg_desktop}"
    else
        _pick "Install desktop environment? (LightDM + XFCE)" "No" "Yes"
        if [[ "${_PICK}" == "Yes" ]]; then
            install_desktop="yes"
        fi
    fi

    # --- 3. Container or VM ---
    local inst_type="" vm_flag=""
    if [[ -n "${_arg_type}" ]]; then
        inst_type="${_arg_type}"
    else
        _pick "Container or VM?" "Container" "VM"
        inst_type="${_PICK}"
    fi
    if [[ "${inst_type}" == "VM" || "${inst_type}" == "vm" ]]; then
        vm_flag="--vm"
        inst_type="VM"
    else
        inst_type="Container"
    fi

    # --- 4. Resources ---
    local memory="" cpus="" disk=""
    if [[ -n "${_arg_memory}" ]]; then
        memory="${_arg_memory}GiB"
    else
        _prompt "Memory in GB" "2"
        memory="${_INPUT}GiB"
    fi
    if [[ -n "${_arg_cpus}" ]]; then
        cpus="${_arg_cpus}"
    else
        _prompt "CPUs" "2"
        cpus="${_INPUT}"
    fi
    if [[ -n "${_arg_disk}" ]]; then
        disk="${_arg_disk}GiB"
    else
        _prompt "Disk size in GB" "10"
        disk="${_INPUT}GiB"
    fi

    # --- 5. Name ---
    local name=""
    if [[ -n "${_arg_name}" ]]; then
        name="${_arg_name}"
    else
        _prompt "Instance name" ""
        name="${_INPUT}"
    fi
    [[ -z "${name}" ]] && _die "Name is required."

    # --- 6. SSH + user ---
    local do_ssh="no" ssh_user=""
    if [[ -n "${_arg_user}" ]]; then
        do_ssh="yes"
        ssh_user="${_arg_user}"
    else
        _pick "Enable SSH for a user?" "Yes" "No"
        if [[ "${_PICK}" == "Yes" ]]; then
            do_ssh="yes"
            _prompt "Primary username" "${USER}"
            ssh_user="${_INPUT}"
        fi
    fi

    # --- 7. Setup scripts ---
    local selected_scripts=()
    _PICKS=()
    if [[ -n "${_arg_scripts}" ]]; then
        IFS=',' read -ra selected_scripts <<< "${_arg_scripts}"
    else
        local scripts_available=()
        if [[ -d "${SCRIPTS_DIR}" ]]; then
            while IFS= read -r f; do
                [[ -n "${f}" ]] && scripts_available+=("$(basename "${f}")")
            done < <(find "${SCRIPTS_DIR}" -maxdepth 1 -name '*.sh' ! -name 'post-*.sh' -type f 2>/dev/null | sort)
        fi
        if [[ ${#scripts_available[@]} -gt 0 ]]; then
            _pick_multi "Select setup scripts to run (from ${SCRIPTS_DIR}):" "${scripts_available[@]}"
        fi
        selected_scripts=("${_PICKS[@]}")
    fi

    # --- Summary ---
    echo ""
    echo "${BOLD}=== Launch Summary ===${NORM}"
    echo "  Version:   ${CYAN}v${VERSION}${NORM}"
    echo "  Image:     ${CYAN}${image}${NORM}"
    echo "  Desktop:   ${CYAN}${install_desktop}${NORM}"
    echo "  Type:      ${CYAN}${inst_type}${NORM}"
    echo "  Name:      ${CYAN}${name}${NORM}"
    echo "  Memory:    ${CYAN}${memory}${NORM}"
    echo "  CPUs:      ${CYAN}${cpus}${NORM}"
    echo "  Disk:      ${CYAN}${disk}${NORM}"
    if [[ "${do_ssh}" == "yes" ]]; then
        echo "  SSH user:  ${CYAN}${ssh_user}${NORM}"
    fi
    if [[ ${#selected_scripts[@]} -gt 0 ]]; then
        echo "  Setup:     ${CYAN}${selected_scripts[*]}${NORM}"
    fi
    echo ""
    if [[ "${_arg_yes}" == "yes" ]]; then
        echo "  (auto-confirmed via --yes)"
    else
        _confirm "Proceed with launch?" || { echo "Aborted."; return 0; }
    fi

    # --- Execute ---

    # 1. Create instance (without starting)
    echo ""
    echo "${BOLD}--- Creating ${name} ---${NORM}"
    local init_cmd="incus init images:${image} ${name}"
    [[ -n "${vm_flag}" ]] && init_cmd+=" ${vm_flag}"
    init_cmd+=" --profile default"
    _run "${init_cmd}"

    # 2. Configure resources (while stopped — avoids ETag races)
    echo ""
    echo "${BOLD}--- Configuring resources ---${NORM}"
    _run "incus config set ${name} limits.memory ${memory}"
    _run "incus config set ${name} limits.cpu ${cpus}"

    # Set disk size (try override first, fall back to set)
    incus config device override "${name}" root size="${disk}" 2>/dev/null ||
        incus config device set "${name}" root size="${disk}" 2>/dev/null ||
        echo "${YELLOW}  Warning: Could not set disk size. You may need to set it manually.${NORM}"

    # 3. Start instance
    echo ""
    echo "${BOLD}--- Starting ${name} ---${NORM}"
    _run "incus start ${name}"

    # 4. Wait for instance to be running
    echo ""
    echo "${BOLD}--- Waiting for ${name} to start ---${NORM}"
    local retries=30
    while [[ ${retries} -gt 0 ]]; do
        local state
        state=$(incus list "${name}" -c s -f csv 2>/dev/null || echo "")
        if [[ "${state}" == "RUNNING" ]]; then
            break
        fi
        echo "  Waiting... (${state:-not ready})"
        sleep 2
        retries=$(( retries - 1 ))
    done
    if [[ ${retries} -eq 0 ]]; then
        _die "Timed out waiting for ${name} to start."
    fi
    echo "  ${GREEN}${name} is running.${NORM}"

    # 5. Wait for cloud-init (if applicable)
    echo ""
    echo "${BOLD}--- Waiting for cloud-init ---${NORM}"
    incus exec "${name}" -- bash -c "
        if command -v cloud-init &>/dev/null; then
            cloud-init status --wait 2>/dev/null || true
        fi
    " 2>/dev/null || true
    echo "  ${GREEN}Ready.${NORM}"

    # 6. Wait for IP address
    echo ""
    echo "${BOLD}--- Waiting for ${name} to get an IP address ---${NORM}"
    local ip_retries=30  # 30 * 2s = 60s timeout
    local got_ip=""
    while [[ ${ip_retries} -gt 0 ]]; do
        got_ip=$(incus list "${name}" -c 4 -f csv 2>/dev/null | sed 's/ (.*//' | grep -v '^$' || true)
        if [[ -n "${got_ip}" ]]; then
            break
        fi
        echo "  Waiting for IP... ($(( (30 - ip_retries) * 2 ))s elapsed)"
        sleep 2
        ip_retries=$(( ip_retries - 1 ))
    done
    if [[ ${ip_retries} -eq 0 ]]; then
        echo "${YELLOW}  Warning: Timed out waiting for IP address after 60s. Continuing anyway.${NORM}"
    else
        echo "  ${GREEN}${name} has IP: ${got_ip}${NORM}"
    fi

    # 7. SSH enable (after IP is available)
    if [[ "${do_ssh}" == "yes" ]]; then
        echo ""
        echo "${BOLD}--- Setting up SSH for ${ssh_user} ---${NORM}"
        _cmd_ssh_enable "${name}" "${ssh_user}"
    fi

    # 8. Setup scripts (always via incus exec — more reliable than SSH
    #    for long-running installs, and scripts need root anyway)
    if [[ ${#selected_scripts[@]} -gt 0 ]]; then
        local logfile="/tmp/incuslaunch.log"
        echo ""
        echo "${BOLD}--- Running setup scripts ---${NORM}"
        echo "  Log: ${logfile}"
        echo "=== incusmagic launch: ${name} — $(date) ===" >> "${logfile}"

        # Push ALL scripts and support files from SCRIPTS_DIR
        echo "  Pushing scripts to ${name}..."
        for push_file in "${SCRIPTS_DIR}"/*.sh "${SCRIPTS_DIR}"/*.conf; do
            [[ -f "${push_file}" ]] || continue
            local push_name
            push_name=$(basename "${push_file}")
            # Skip post-scripts — they run on the host, not inside the container
            [[ "${push_name}" == post-* ]] && continue
            incus file push "${push_file}" "${name}/tmp/${push_name}"
            incus exec "${name}" -- chmod +x "/tmp/${push_name}" 2>/dev/null || true
        done

        # Run only the selected scripts
        for script_name in "${selected_scripts[@]}"; do
            local script_path="${SCRIPTS_DIR}/${script_name}"
            if [[ ! -f "${script_path}" ]]; then
                echo "${RED}  Script not found: ${script_path}${NORM}"
                continue
            fi

            echo ""
            echo "${CYAN}>>> ${script_name}${NORM}"
            echo "--- ${script_name} started: $(date) ---" >> "${logfile}"
            local exec_env=""
            if [[ "${do_ssh}" == "yes" && -n "${ssh_user}" ]]; then
                exec_env="--env SETUP_USER=${ssh_user}"
            fi
            if [[ "${install_desktop}" == "yes" ]]; then
                exec_env="${exec_env} --env INSTALL_DESKTOP=1"
            fi
            incus exec "${name}" ${exec_env} -- bash "/tmp/${script_name}" 2>&1 | tee -a "${logfile}"
            echo "--- ${script_name} finished: $(date) ---" >> "${logfile}"
            echo "${GREEN}  <<< ${script_name} done${NORM}"
        done
    fi

    # 8.5. Post-scripts (run locally on the host after remote scripts complete)
    if [[ ${#selected_scripts[@]} -gt 0 ]]; then
        local post_scripts_ran=0
        for script_name in "${selected_scripts[@]}"; do
            local post_script_name="post-${script_name}"
            local post_script_path="${SCRIPTS_DIR}/${post_script_name}"
            if [[ -f "${post_script_path}" ]]; then
                if [[ ${post_scripts_ran} -eq 0 ]]; then
                    echo ""
                    echo "${BOLD}--- Running post-scripts (on host) ---${NORM}"
                fi
                post_scripts_ran=$(( post_scripts_ran + 1 ))
                echo ""
                echo "${CYAN}>>> ${post_script_name} (local)${NORM}"
                INSTANCE_NAME="${name}" \
                SETUP_USER="${ssh_user}" \
                INSTANCE_IP="${got_ip}" \
                    bash "${post_script_path}"
                echo "${GREEN}  <<< ${post_script_name} done${NORM}"
            fi
        done
    fi

    echo ""
    echo "${BOLD}=== Launch complete ===${NORM}"
    echo "  Instance: ${GREEN}${name}${NORM}"
    if [[ "${do_ssh}" == "yes" ]]; then
        echo "  Connect:  ${CYAN}ssh ${name}${NORM}"
    else
        echo "  Connect:  ${CYAN}incus exec ${name} -- bash${NORM}"
    fi
}

