_incusmagic() {
    local -a nouns
    nouns=(
        'container:Manage containers (alias: c)'
        'profile:Manage profiles (alias: p)'
        'network:Manage networks (alias: net)'
        'image:Manage images (alias: img)'
        'launch:Launch containers (alias: l)'
        'list:List containers (alias: ls)'
        'backup:Backup containers (alias: b)'
        'ssh:SSH management'
        'storage:Storage management (alias: st)'
        'port:Port forwarding'
        'diag:Diagnostics (alias: d)'
        'report:Reports (alias: r)'
        'ps:Process management'
        'remote:Remote container management (alias: rem)'
        'customization:Customization files (alias: cust)'
        'start-over:Start over (destructive)'
        'k8s:Kubernetes helpers'
        'find-actions:Find GitHub Actions runners'
        'docs:Open documentation'
        'reload:Reload environment'
        'completion:Shell completions'
        'version:Show version'
        'help:Show help'
    )

    local -a aliases
    aliases=(
        'c:container' 'p:profile' 'net:network' 'img:image'
        'l:launch' 'ls:list' 'b:backup' 'st:storage'
        'd:diag' 'r:report' 'rem:remote' 'cust:customization'
    )

    if (( CURRENT == 2 )); then
        _describe 'command' nouns
        _describe 'alias' aliases
        return
    fi

    local noun="${words[2]}"
    # Resolve aliases
    case "${noun}" in
        c) noun=container ;; p) noun=profile ;; net) noun=network ;;
        img) noun=image ;; l) noun=launch ;; ls) noun=list ;;
        b) noun=backup ;; st) noun=storage ;; d) noun=diag ;;
        r) noun=report ;; rem) noun=remote ;; cust) noun=customization ;;
    esac

    if (( CURRENT == 3 )); then
        local -a verbs
        case "${noun}" in
            container) verbs=(start stop restart delete start-all stop-all restart-all delete-all set-memory set-cpu resize exec-all run-all destroy-relaunch) ;;
            profile) verbs=(add remove add-multi remove-multi delete delete-all) ;;
            network) verbs=(delete delete-all) ;;
            image) verbs=(list delete delete-all) ;;
            launch) verbs=(wizard recommended clone test) ;;
            list) verbs=(wide narrow csv) ;;
            backup) verbs=(all) ;;
            ssh) verbs=(enable) ;;
            storage) verbs=(move) ;;
            port) verbs=(forward) ;;
            diag) verbs=(top inotify disks systemd-udevd) ;;
            report) verbs=(disks disksize) ;;
            ps) verbs=(systemd tree find) ;;
            remote) verbs=(install start get-pm) ;;
            customization) verbs=(delete) ;;
            start-over) verbs=(full active configs report) ;;
            k8s) verbs=(cluster) ;;
            completion) verbs=(bash zsh install) ;;
            help)
                _describe 'topic' nouns
                return
                ;;
        esac
        _describe 'subcommand' verbs
        return
    fi

    # Dynamic completions for arguments
    local verb="${words[3]}"
    case "${noun}" in
        container)
            case "${verb}" in
                start|stop|restart|delete|set-memory|set-cpu|destroy-relaunch)
                    _incusmagic_get_containers ;;
                resize)
                    if (( CURRENT == 4 )); then
                        local -a kinds=(disk memory cpu)
                        _describe 'resource' kinds
                    else
                        _incusmagic_get_containers
                    fi
                    ;;
            esac
            ;;
        profile)
            case "${verb}" in
                add|remove|delete)
                    if (( CURRENT == 4 )); then
                        _incusmagic_get_profiles
                    else
                        _incusmagic_get_containers
                    fi
                    ;;
                add-multi|remove-multi)
                    if (( CURRENT == 4 )); then
                        _incusmagic_get_containers
                    else
                        _incusmagic_get_profiles
                    fi
                    ;;
            esac
            ;;
        network) _incusmagic_get_networks ;;
        storage)
            if (( CURRENT == 4 )); then
                _incusmagic_get_pools
            else
                _incusmagic_get_containers
            fi
            ;;
        backup) _incusmagic_get_containers ;;
        customization)
            if [[ "${verb}" == "delete" ]] && (( CURRENT == 4 )); then
                local -a types=(profiles startcmds networks projects storage)
                _describe 'type' types
            fi
            ;;
        report)
            if [[ "${verb}" == "disksize" ]] && (( CURRENT == 4 )); then
                _incusmagic_get_pools
            fi
            ;;
    esac
}

compdef _incusmagic incusmagic im
ZSH_COMP
}

