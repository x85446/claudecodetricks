# ---- remote ----

_get_package_manager() {
    local container="$1"
    local os_id
    os_id=$(incus exec "${container}" -- cat /etc/os-release 2>/dev/null | grep '^ID=' | cut -d'=' -f2 | tr -d '"')
    case "${os_id}" in
        debian|ubuntu|linuxmint) echo "apt" ;;
        rhel|centos|fedora)
            local os_version
            os_version=$(incus exec "${container}" -- cat /etc/os-release 2>/dev/null | grep '^VERSION_ID=' | cut -d'=' -f2 | tr -d '"' | cut -d'.' -f1)
            if [[ "${os_id}" == "fedora" ]] && (( os_version >= 22 )) || [[ "${os_id}" != "fedora" ]] && (( os_version >= 8 )); then
                echo "dnf"
            else
                echo "yum"
            fi
            ;;
        opensuse*) echo "zypper" ;;
        arch|manjaro) echo "pacman" ;;
        *) echo "unknown"; return 2 ;;
    esac
}

_remote_install() {
    local container="$1" pm="$2"
    shift 2
    local programs="$*"
    case "${pm}" in
        apt)    incus exec "${container}" -- apt-get update && incus exec "${container}" -- apt install -y ${programs} ;;
        yum)    incus exec "${container}" -- yum update -y && incus exec "${container}" -- yum install -y ${programs} ;;
        dnf)    incus exec "${container}" -- dnf update -y && incus exec "${container}" -- dnf install -y ${programs} ;;
        zypper) incus exec "${container}" -- zypper refresh && incus exec "${container}" -- zypper install -y ${programs} ;;
        pacman) incus exec "${container}" -- pacman -Syu --noconfirm && incus exec "${container}" -- pacman -S --noconfirm ${programs} ;;
        *) echo "Unknown package manager: ${pm}" >&2; return 1 ;;
    esac
}

_remote_start() {
    local container="$1" pm="$2"
    shift 2
    for program in "$@"; do
        case "${pm}" in
            apt|yum|dnf|pacman)
                incus exec "${container}" -- systemctl enable "${program}"
                ;;
            zypper)
                incus exec "${container}" -- chkconfig "${program}" on
                ;;
        esac
        incus exec "${container}" -- systemctl start "${program}"
    done
}

_cmd_remote_install() {
    _need_args 3 $# "remote install <container> <pkg-mgr> <packages...>" || return 1
    local container pm
    container="$(_apply_remote "$1")"
    pm="$2"
    shift 2
    _remote_install "${container}" "${pm}" "$@"
}
_cmd_remote_start() {
    _need_args 3 $# "remote start <container> <pkg-mgr> <services...>" || return 1
    local container pm
    container="$(_apply_remote "$1")"
    pm="$2"
