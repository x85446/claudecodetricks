_cmd_image_delete_all() {
    local yes=false
    [[ "${1:-}" == "--yes" ]] && { yes=true; shift; }
    local fps
    fps=$(_get_all_image_fingerprints)
    [[ -z "${fps}" ]] && { echo "No images to delete."; return 0; }
    if $yes; then
        _variadic_exec --no-verify --no-remote "incus image delete {item}" ${fps}
    else
        _variadic_exec --verify --no-remote "incus image delete {item}" ${fps}
    fi
}

# ---- launch ----

_cmd_launch() {
    local image="" name="" profiles=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --image)   image="$2";   shift 2 ;;
            --profile) profiles+=("$2"); shift 2 ;;
            -*)        _die "Unknown flag: $1" ;;
            *)
                if [[ -z "${name}" ]]; then
                    name="$1"; shift
                else
                    _die "Unexpected argument: $1"
                fi
                ;;
        esac
    done
    [[ -z "${name}" ]] && _die "Usage: ${PROG} launch <name> [--image IMAGE] [--profile PROFILE...]"
    [[ -z "${image}" ]] && image="ubuntu/24.04"
    local profile_args=""
    if [[ ${#profiles[@]} -gt 0 ]]; then
        for p in "${profiles[@]}"; do
            profile_args+=" --profile ${p}"
        done
    else
        profile_args=" --profile default"
    fi
    name="$(_apply_remote "${name}")"
    _run "incus launch images:${image} ${name}${profile_args}"
}
_cmd_launch_recommended() {
    _need_args 1 $# "launch recommended <name>" || return 1
    local container; container="$(_apply_remote "$1")"
    if [[ -n "${defaultLaunch:-}" ]]; then
        local ready="${defaultLaunch//\$container/${container}}"
        _run "${ready}"
    else
        echo "No defaultLaunch variable defined."
        echo "Set it in /etc/profile.d/10-incus-magic-vars.sh or ~/.usermagic"
    fi
}
_cmd_launch_clone() {
    _need_args 2 $# "launch clone <original> <new> [--image IMAGE]" || return 1
    local original new_name image="${3:-}"
    original="$(_apply_remote "$1")"
    new_name="$(_apply_remote "$2")"
    # strip --image flag if used
    if [[ "${3:-}" == "--image" ]]; then
        image="${4:-}"
    fi
    if [[ -z "${image}" ]]; then
        local i1 i2
        i1=$(incus config show "${original}" 2>/dev/null | grep image.os | awk -F ": " '{print $2}' | tr '[:upper:]' '[:lower:]')
        i2=$(incus config show "${original}" 2>/dev/null | grep image.release | awk -F ": " '{print $2}' | tr '[:upper:]' '[:lower:]')
        image="${i1}/${i2}"
    fi
    local allP
    allP=$(_get_container_profiles "${original}")
    local profile_args=""
    for p in ${allP}; do
        profile_args+=" --profile ${p}"
    done
    echo "${CYAN}incus launch images:${image} ${new_name}${profile_args}${NORM}"
    if _confirm "Proceed?"; then
        _run "incus launch images:${image} ${new_name}${profile_args}"
    fi
}
