# ---- start-over ----

_cmd_start_over_full() {
    local yes=false
    [[ "${1:-}" == "--yes" ]] && { yes=true; shift; }
    if ! $yes; then
        _confirm "This will delete ALL containers, profiles, networks, and customization files. Continue?" || return 0
    fi
    # Delete containers
    local names
    names=$(_get_all_container_names)
    [[ -n "${names}" ]] && _variadic_exec --no-verify "incus stop --force {item};incus delete --force {item}" ${names}
    # Delete profiles
    local profiles
    profiles=$(_get_all_profiles)
    [[ -n "${profiles}" ]] && _variadic_exec --no-verify "incus profile delete {item}" ${profiles}
    # Delete networks (except incusbr0)
    local networks
    networks=$(_get_all_networks)
    local filtered=""
    for net in ${networks}; do
        [[ "${net}" != "incusbr0" ]] && filtered="${filtered} ${net}"
    done
    [[ -n "${filtered}" ]] && _variadic_exec --no-verify "incus network delete {item}" ${filtered}
    # Delete customization
    sudo rm -rf "${OPT_DIR}"
    echo "Start-over complete."
}
