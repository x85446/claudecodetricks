#!/usr/bin/env bash
# ============================================================
# incusmagic - Incus host management CLI
# ============================================================
# Replaces the old incus-magic.sh sourced profile.d script.
# Install: /usr/local/bin/incusmagic  (symlink: /usr/local/bin/im)
# ============================================================

# On macOS with old bash, re-exec under Homebrew bash if available
if [[ "${BASH_VERSINFO[0]}" -lt 4 ]] && [[ -z "${_INCUSMAGIC_REEXEC:-}" ]]; then
    for _brew_bash in /opt/homebrew/bin/bash /usr/local/bin/bash; do
        if [[ -x "${_brew_bash}" ]]; then
            export _INCUSMAGIC_REEXEC=1
            exec "${_brew_bash}" "$0" "$@"
        fi
    done
    unset _brew_bash
fi
unset _INCUSMAGIC_REEXEC 2>/dev/null || true

set -euo pipefail

readonly VERSION="1.3.0"
readonly PROG="${0##*/}"
readonly OPT_DIR="/opt/incus/customization"

# Project context: when set, exported INCUS_PROJECT is honored by the incus CLI,
# so every `incus ...` invocation in this script automatically scopes to it.
# Set via top-level `--project NAME` / `-P NAME`, inherited from the environment,
# or auto-detected by _is_container() when a container is found in a non-default project.
INCUS_PROJECT="${INCUS_PROJECT:-}"
export INCUS_PROJECT

# Remote context: when set, every `incus` invocation that targets a container/VM
# is automatically prefixed with `${INCUS_REMOTE}:`. Set via top-level
# `--remote NAME` / `-R NAME`, inherited from the environment, or specified
# inline as `remote:name` on any subcommand that accepts a name. Inline
# `remote:name` always wins over the default INCUS_REMOTE.
INCUS_REMOTE="${INCUS_REMOTE:-}"
export INCUS_REMOTE

# Apply the active INCUS_REMOTE to a bare container/VM name. If the name
# already contains a colon (already qualified with a remote), pass through
# unchanged. If INCUS_REMOTE is empty, also pass through unchanged.
_apply_remote() {
    local name="$1"
    if [[ "${name}" == *:* ]]; then
        echo "${name}"
    elif [[ -n "${INCUS_REMOTE}" ]]; then
        echo "${INCUS_REMOTE}:${name}"
    else
        echo "${name}"
    fi
}

# Split a "remote:name" or bare "name" into REMOTE_PREFIX and BARE_NAME globals.
# REMOTE_PREFIX is "remote:" (with the colon) or empty.
# BARE_NAME is the name without any remote prefix.
_split_target() {
    local input="$1"
    if [[ "${input}" == *:* ]]; then
        REMOTE_PREFIX="${input%%:*}:"
        BARE_NAME="${input#*:}"
    elif [[ -n "${INCUS_REMOTE}" ]]; then
        REMOTE_PREFIX="${INCUS_REMOTE}:"
        BARE_NAME="${input}"
    else
        REMOTE_PREFIX=""
        BARE_NAME="${input}"
    fi
}

# --- 1. Colors & Terminal Helpers -------------------------------------------

if [[ -t 1 ]]; then
    NORM="$(tput sgr0)"
    BOLD="$(tput bold)"
    UND="$(tput smul)"
    RED="$(tput setaf 1)"
    GREEN="$(tput setaf 2)"
    YELLOW="$(tput setaf 3)"
    BLUE="$(tput setaf 4)"
    CYAN="$(tput setaf 6)"
    WHITE="$(tput setaf 7)"
else
    NORM="" BOLD="" UND="" RED="" GREEN="" YELLOW="" BLUE="" CYAN="" WHITE=""
fi

DISPLAY_ALL_CMDS=1

# --- Source environment vars (same files the old script sourced) ---
# Disable nounset while sourcing: legacy vars files on some hosts contain
# unquoted "$container" placeholders that the file's author intended to be
# literal but which bash expands at assignment time.
set +u
[[ -f /etc/profile.d/10-incus-magic-vars.sh ]] && source /etc/profile.d/10-incus-magic-vars.sh
[[ -f "${HOME}/.usermagic" ]] && source "${HOME}/.usermagic"
set -u

# ============================================================
# 2. Utility Functions (all prefixed with _)
# ============================================================

_confirm() {
    local msg="${1:-Continue?}"
    echo -ne "${WHITE}${msg} ${NORM}"
    echo -en "${YELLOW}Press (y|n): ${RED}"
    read -r -n 1 ynres || true
    echo -en "${NORM}"
    if [[ "${ynres}" == "Y" || "${ynres}" == "y" ]]; then
        echo " yes"
        return 0
    else
        echo " no"
        return 1
    fi
}

_run() {
    if [[ ${DISPLAY_ALL_CMDS} -eq 1 ]]; then
        echo -en "  cmd: "
        echo "${YELLOW}$1${NORM}"
    fi
    if [[ "${2:-}" == "" ]]; then
        eval "$1"
    fi
}

_die() {
    echo "${RED}Error:${NORM} $*" >&2
    exit 1
}

_need_args() {
    local min="$1"
    local actual="$2"
    local usage="$3"
    if [[ "${actual}" -lt "${min}" ]]; then
        echo "Usage: ${PROG} ${usage}" >&2
        return 1
    fi
}

# Execute a command template against each item in a variadic list.
# Usage: _variadic_exec [--verify|--no-verify] "cmd template with {item}" item1 item2 ...
# The template can also use {one} for a leading fixed arg:
#   _variadic_exec --no-verify --fixed "VALUE" "incus config set {item} limits.memory {one}" c1 c2
_variadic_exec() {
    local verify=false
    local fixed_val=""
    # Whether to apply the active INCUS_REMOTE prefix to each {item}. Defaults
    # to true (most callers iterate over container/VM names). Pass --no-remote
    # for callers whose items are NOT containers (e.g. profile names, image
    # fingerprints, network names).
    local apply_remote=true
    while true; do
        case "${1:-}" in
            --verify)    verify=true;  shift ;;
            --no-verify) verify=false; shift ;;
            --fixed)     fixed_val="$2"; shift 2 ;;
            --remote)    apply_remote=true;  shift ;;
            --no-remote) apply_remote=false; shift ;;
            *) break ;;
        esac
    done
    local cmd_template="$1"; shift

    [[ $# -eq 0 ]] && { echo "Error: No items specified" >&2; return 1; }

    # Replace {one} with the fixed value
    cmd_template="${cmd_template//\{one\}/${fixed_val}}"

    if $verify; then
        echo "This will affect: ${CYAN}$*${NORM}"
        _confirm "Would you like to continue?" || return 0
    fi

    for item in "$@"; do
        if $apply_remote; then
            item="$(_apply_remote "${item}")"
        fi
        local cmd="${cmd_template//\{item\}/$item}"
        IFS=';' read -ra subcmds <<< "$cmd"
        for subcmd in "${subcmds[@]}"; do
            subcmd="${subcmd## }"; subcmd="${subcmd%% }"
            _run "$subcmd"
        done
    done
}

# --- Data getters ---

_get_all_container_names() {
    # Optional arg: explicit remote prefix override (e.g. "H91:"). When unset,
    # uses INCUS_REMOTE if exported, else the default local remote.
    local _rp="${1:-}"
    [[ -z "${_rp}" && -n "${INCUS_REMOTE}" ]] && _rp="${INCUS_REMOTE}:"
    incus list "${_rp}" -c n -f csv 2>/dev/null | awk -F ',' '{print $1}' | xargs
}
_get_running_container_names() {
    local _rp="${1:-}"
    [[ -z "${_rp}" && -n "${INCUS_REMOTE}" ]] && _rp="${INCUS_REMOTE}:"
    incus list "${_rp}" status=RUNNING -c n -f csv 2>/dev/null | awk -F ',' '{print $1}' | xargs
}
_get_stopped_container_names() {
    local _rp="${1:-}"
    [[ -z "${_rp}" && -n "${INCUS_REMOTE}" ]] && _rp="${INCUS_REMOTE}:"
    incus list "${_rp}" status=STOPPED -c n -f csv 2>/dev/null | awk -F ',' '{print $1}' | xargs
}
_get_all_image_fingerprints() {
    local _rp="${1:-}"
    [[ -z "${_rp}" && -n "${INCUS_REMOTE}" ]] && _rp="${INCUS_REMOTE}:"
    incus image list "${_rp}" -f csv -c f 2>/dev/null | xargs
}
_get_all_profiles() {
    local _rp="${1:-}"
    [[ -z "${_rp}" && -n "${INCUS_REMOTE}" ]] && _rp="${INCUS_REMOTE}:"
    incus profile list "${_rp}" -f csv 2>/dev/null | awk -F ',' '{print $1}' | grep -v -e '^default$' -e '^disk-default$' | xargs
}
_get_container_profiles() {
    local container; container="$(_apply_remote "$1")"
    incus list -c P -f csv "${container}" 2>/dev/null | awk -F ',' '{gsub("\"", "", $0); print}' | xargs
}
_get_all_networks() {
    local _rp="${1:-}"
    [[ -z "${_rp}" && -n "${INCUS_REMOTE}" ]] && _rp="${INCUS_REMOTE}:"
    incus network list "${_rp}" -f csv 2>/dev/null | grep ',CREATED$' | awk -F ',' '{print $1}' | xargs
}
# Find which project a container lives in by searching across all projects.
# Echoes the project name on stdout, or nothing if not found.
_find_container_project() {
    local target; target="$(_apply_remote "$1")"
    local rp=""
    if [[ "${target}" == *:* ]]; then
        rp="${target%%:*}:"
    fi
    local bare="${target##*:}"
    incus list "${rp}" --all-projects -c en -f csv 2>/dev/null \
        | awk -F ',' -v name="${bare}" '$2==name {print $1; exit}'
}

# Returns 0 if the named container exists in the current project, OR if it
# can be located in another project (in which case INCUS_PROJECT is updated
# and exported so subsequent incus calls scope to that project).
# Accepts bare "name" or "remote:name".
_is_container() {
    local target; target="$(_apply_remote "$1")"
    local bare="${target##*:}"
    if incus list "${target}" -c n -f csv 2>/dev/null | grep -q "${bare}"; then
        return 0
    fi
    # Not in current project — search all projects and adopt the one we find it in.
    local detected
    detected=$(_find_container_project "${target}")
    if [[ -n "${detected}" ]]; then
        if [[ "${detected}" != "${INCUS_PROJECT:-default}" ]]; then
            echo "${YELLOW}Note:${NORM} '${bare}' found in project '${BOLD}${detected}${NORM}'; using that project for this command." >&2
        fi
        INCUS_PROJECT="${detected}"
        export INCUS_PROJECT
        return 0
    fi
    return 1
}
_get_customization_items() {
    local subdir="$1"
    local path="${OPT_DIR}/${subdir}"
    if [[ -d "${path}" ]]; then
        ls "${path}/" 2>/dev/null | xargs
    fi
}

# --- Terminal link helper ---
_termurl() {
    local texturl="$1" url="$2"
    local bell esc
    bell=$(echo -e "\x07")
    esc=$(echo -e "\x1b")
    echo "${esc}]8;;${url}${bell}${texturl}${esc}]8;;${bell}"
}

# --- printTable (kept mostly as-is from original) ---
_printTable() {
    local delimiter="$1"
    IFS="${delimiter}" read -ra justification <<< "$2"
    IFS="${delimiter}" read -ra widths <<< "$3"
    local header="$4"
    local footer="$5"
    local _data_var="$6"
    # Bash 3.2 compatible: copy array by name instead of nameref
    eval 'local _data_items=("${'${_data_var}'[@]}")'
    local total_width=0
    for width in "${widths[@]}"; do
        total_width=$(( total_width + width ))
    done
    total_width=$(( total_width - 1 ))

    _printRow() {
        IFS="${delimiter}" read -ra row <<< "$1"
        local output=""
        for (( i = 0; i < ${#row[@]}; i++ )); do
            local cell="${row[$i]}"
            local width="${widths[$i]}"
            local justify="${justification[$i]}"
            local cell_output=""
            if [[ ${#cell} -gt "${width}" ]]; then
                cell="${cell:0:$((width - 4))}..."
            fi
            local thisWidth=$(( width - 1 ))
            if [[ "${justify}" == "justifyRight" ]]; then
                printf -v cell_output "%${thisWidth}s" "${cell}"
            elif [[ "${justify}" == "center" ]]; then
                local padding=$(( (thisWidth - ${#cell}) / 2 ))
                printf -v cell_output "%${padding}s%s%${padding}s" "" "${cell}" ""
            else
                printf -v cell_output "%-${thisWidth}s" "${cell}"
            fi
            output+="${cell_output} "
        done
        echo "${output}"
    }

    _printLine() {
        printf "%s\n" "$(printf '%*s' "${total_width}" | tr ' ' '-')"
    }

    echo "$(_printRow "${header}")"
    _printLine
    for row in "${_data_items[@]}"; do
        if [[ "${row}" == "-" ]]; then
            _printLine
        else
            echo "$(_printRow "${row}")"
        fi
    done
    if [[ -n "${footer}" ]] && [[ "${footer}" != "," ]]; then
        _printLine
        echo "$(_printRow "${footer}")"
    fi
}

# ============================================================
# 3. Subcommand Implementations
# ============================================================

# ---- container ----

_cmd_container_start() {
    _need_args 1 $# "container start <name...>" || return 1
    _variadic_exec --no-verify "incus start {item}" "$@"
}
_cmd_container_stop() {
    _need_args 1 $# "container stop <name...>" || return 1
    _variadic_exec --no-verify "incus stop {item}" "$@"
}
_cmd_container_restart() {
    _need_args 1 $# "container restart <name...>" || return 1
    _variadic_exec --no-verify "incus restart {item}" "$@"
}
_cmd_container_delete() {
    local force=false
    while [[ "${1:-}" == --* ]]; do
        case "$1" in
            --force) force=true; shift ;;
            *) _die "Unknown flag: $1" ;;
        esac
    done
    _need_args 1 $# "container delete [--force] <name...>" || return 1
    if $force; then
        _variadic_exec --verify "incus stop --force {item};incus delete --force {item}" "$@"
    else
        _variadic_exec --verify "incus stop --force {item};incus delete {item}" "$@"
    fi
}
_cmd_container_start_all() {
    local names
    names=$(_get_all_container_names)
    [[ -z "${names}" ]] && { echo "No containers found."; return 0; }
    _variadic_exec --no-verify "incus start {item}" ${names}
}
_cmd_container_stop_all() {
    local names
    names=$(_get_all_container_names)
    [[ -z "${names}" ]] && { echo "No containers found."; return 0; }
    _variadic_exec --no-verify "incus stop {item}" ${names}
}
_cmd_container_restart_all() {
    local names
    names=$(_get_all_container_names)
    [[ -z "${names}" ]] && { echo "No containers found."; return 0; }
    _variadic_exec --verify "incus restart {item}" ${names}
}
_cmd_container_delete_all() {
    local force=false yes=false
    while [[ "${1:-}" == --* ]]; do
        case "$1" in
            --force) force=true; shift ;;
            --yes)   yes=true;   shift ;;
            *) _die "Unknown flag: $1" ;;
        esac
    done
    local names
    names=$(_get_all_container_names)
    [[ -z "${names}" ]] && { echo "No containers found."; return 0; }
    if $yes; then
        if $force; then
            _variadic_exec --no-verify "incus stop --force {item};incus delete --force {item}" ${names}
        else
            _variadic_exec --no-verify "incus stop --force {item};incus delete {item}" ${names}
        fi
    else
        if $force; then
            _variadic_exec --verify "incus stop --force {item};incus delete --force {item}" ${names}
        else
            _variadic_exec --verify "incus stop --force {item};incus delete {item}" ${names}
        fi
    fi
}
_cmd_container_resize_disk() {
    _need_args 2 $# "container resize disk <size> <name...> [--override]" || return 1
    local size="$1"; shift
    local override=false
    local items=()
    for arg in "$@"; do
        if [[ "$arg" == "--override" ]]; then
            override=true
        else
            items+=("$arg")
        fi
    done
    if $override; then
        _variadic_exec --no-verify --fixed "${size}" "incus config device set {item} root size={one}" "${items[@]}"
    else
        _variadic_exec --no-verify --fixed "${size}" "incus config device override {item} root size={one}" "${items[@]}"
    fi
}
_cmd_container_resize_memory() {
    _need_args 2 $# "container resize memory <mem> <name...>" || return 1
    local mem="$1"; shift
    _variadic_exec --no-verify --fixed "${mem}" "incus stop {item};incus config set {item} limits.memory {one};incus start {item}" "$@"
}
_cmd_container_resize_cpu() {
    _need_args 2 $# "container resize cpu <cpu> <name...>" || return 1
    local cpu="$1"; shift
    _variadic_exec --no-verify --fixed "${cpu}" "incus config set {item} limits.cpu {one}" "$@"
}
_cmd_container_set_memory() {
    _need_args 2 $# "container set-memory <mem> <name...>" || return 1
    _cmd_container_resize_memory "$@"
}
_cmd_container_set_cpu() {
    _need_args 2 $# "container set-cpu <cpu> <name...>" || return 1
    _cmd_container_resize_cpu "$@"
}
_cmd_container_resize() {
    _need_args 1 $# "container resize <disk|memory|cpu> <size> <name...> [--override]" || return 1
    local what="$1"; shift
    case "${what}" in
        disk)   _cmd_container_resize_disk "$@" ;;
        memory|mem) _cmd_container_resize_memory "$@" ;;
        cpu)    _cmd_container_resize_cpu "$@" ;;
        --help|-h|help)
            echo "Usage: ${PROG} container resize <disk|memory|cpu> <value> <name...> [--override]"
            echo ""
            echo "  disk   <size>  <name...> [--override]   Resize root disk (e.g. 50GiB)"
            echo "  memory <mem>   <name...>                Set memory limit (e.g. 4GiB)"
            echo "  cpu    <cpu>   <name...>                Set CPU limit (e.g. 4)"
            ;;
        *)
            _die "Unknown resize target: ${what}. Expected: disk, memory, or cpu"
            ;;
    esac
}
_cmd_container_exec_all() {
    _need_args 1 $# "container exec-all <cmd>" || return 1
    local cmd="$*"
    for container in $(_get_all_container_names); do
        local target; target="$(_apply_remote "${container}")"
        echo ""
        echo "${CYAN}${target}${NORM}"
        incus exec "${target}" -- bash -c "${cmd}"
    done
}
_cmd_container_run_all() {
    _need_args 1 $# "container run-all <cmd>" || return 1
    local cmd="$*"
    for mm in $(_get_running_container_names); do
        local target; target="$(_apply_remote "${mm}")"
        echo "-----------------------------------------------------------"
        echo "${CYAN}${target}${NORM}"
        incus exec "${target}" -- bash -c "${cmd}"
    done
}
_cmd_container_destroy_relaunch() {
    _need_args 1 $# "container destroy-relaunch <name>" || return 1
    local input="$1"
    local target; target="$(_apply_remote "${input}")"
    local name="${target##*:}"
    local rp=""
    [[ "${target}" == *:* ]] && rp="${target%%:*}:"
    if incus list "${rp}" -c nD -f csv 2>/dev/null | grep -q "$name"; then
        incus stop "${target}" 2>/dev/null || true
        incus delete "${target}"
    else
        echo "Container ${target} does not exist"
    fi
    if [[ -f "${OPT_DIR}/automation/startcmds/$name" ]]; then
        bash "${OPT_DIR}/automation/startcmds/$name"
    else
        echo "Start command file $name does not exist"
    fi
}

# ---- profile ----

_cmd_profile_add() {
    _need_args 2 $# "profile add <profile> <container...>" || return 1
    local profile="$1"; shift
    _variadic_exec --no-verify --fixed "${profile}" "incus profile add {item} {one}" "$@"
}
_cmd_profile_remove() {
    _need_args 2 $# "profile remove <profile> <container...>" || return 1
    local profile="$1"; shift
    _variadic_exec --no-verify --fixed "${profile}" "incus profile remove {item} {one}" "$@"
}
_cmd_profile_add_multi() {
    _need_args 2 $# "profile add-multi <container> <profile...>" || return 1
    local container; container="$(_apply_remote "$1")"; shift
    _variadic_exec --no-verify --no-remote --fixed "${container}" "incus profile add {one} {item}" "$@"
}
_cmd_profile_remove_multi() {
    _need_args 2 $# "profile remove-multi <container> <profile...>" || return 1
    local container; container="$(_apply_remote "$1")"; shift
    _variadic_exec --no-verify --no-remote --fixed "${container}" "incus profile remove {one} {item}" "$@"
}
_cmd_profile_delete() {
    _need_args 1 $# "profile delete <name...>" || return 1
    _variadic_exec --verify --no-remote "incus profile delete {item}" "$@"
}
_cmd_profile_delete_all() {
    local yes=false
    [[ "${1:-}" == "--yes" ]] && { yes=true; shift; }
    local profiles
    profiles=$(_get_all_profiles)
    [[ -z "${profiles}" ]] && { echo "No profiles to delete."; return 0; }
    if $yes; then
        _variadic_exec --no-verify --no-remote "incus profile delete {item}" ${profiles}
    else
        _variadic_exec --verify --no-remote "incus profile delete {item}" ${profiles}
    fi
}

# ---- network ----

_cmd_network_delete() {
    _need_args 1 $# "network delete <name...>" || return 1
    local filtered=()
    for net in "$@"; do
        if [[ "${net}" == "incusbr0" ]]; then
            _confirm "incusbr0 is a default network. Delete it too?" || continue
        fi
        filtered+=("${net}")
    done
    [[ ${#filtered[@]} -eq 0 ]] && { echo "No networks to delete."; return 0; }
    _variadic_exec --verify --no-remote "incus network delete {item}" "${filtered[@]}"
}
_cmd_network_delete_all() {
    local yes=false
    [[ "${1:-}" == "--yes" ]] && { yes=true; shift; }
    local networks
    networks=$(_get_all_networks)
    [[ -z "${networks}" ]] && { echo "No networks to delete."; return 0; }

    local has_incusbr0=false
    local filtered=""
    for net in ${networks}; do
        if [[ "${net}" == "incusbr0" ]]; then
            has_incusbr0=true
        else
            filtered="${filtered} ${net}"
        fi
    done

    if ${has_incusbr0}; then
        if _confirm "incusbr0 is a default network. Delete it too?"; then
            filtered="${filtered} incusbr0"
        fi
    fi

    filtered="${filtered## }"
    [[ -z "${filtered}" ]] && { echo "No networks to delete."; return 0; }

    if $yes; then
        _variadic_exec --no-verify --no-remote "incus network delete {item}" ${filtered}
    else
        _variadic_exec --verify --no-remote "incus network delete {item}" ${filtered}
    fi
}

# ---- image ----

_cmd_image_list() {
    local filter="${1:-}"
    _run "incus image list images:${filter}"
}
_cmd_image_delete() {
    _need_args 1 $# "image delete <fingerprint...>" || return 1
    _variadic_exec --verify --no-remote "incus image delete {item}" "$@"
