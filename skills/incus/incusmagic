# ---- find-actions ----

_cmd_find_actions() {
    local cnames="${*:-$(_get_running_container_names)}"
    for mm in ${cnames}; do
        echo "-----------------------------------------------------------"
        echo "${CYAN}${mm}${NORM}"
        local output
        output=$(incus exec "${mm}" -- bash -c "systemctl status actions.runner.* 2>/dev/null | grep actions.runner. | grep GitHub" 2>/dev/null || true)
        [[ -z "${output}" ]] && { echo "  No GitHub Actions runners found."; continue; }
        while IFS= read -r ogline; do
            local service status path repo
            service="${ogline#* }"
            service="${service%% -*}"
            status=$(incus exec "${mm}" -- bash -c "systemctl status ${service} 2>/dev/null | grep Active:" 2>/dev/null || true)
            status="${status#*: }"; status="${status%% *}"
            path=$(incus exec "${mm}" -- bash -c "systemctl status ${service} 2>/dev/null | grep -A3 CGroup | grep Runner.Listen" 2>/dev/null || true)
            path="${path#* /}"; path="/${path%% run*}"
            local repoQuery="${path%bin/Runner.Listener}_diag"
            repo=$(incus exec "${mm}" -- bash -c "if [ -d ${repoQuery} ]; then cd ${repoQuery}; grep github.com \$(ls -1 Runner_* 2>/dev/null | tail -n1) 2>/dev/null; fi" 2>/dev/null || echo "not found")
            if [[ "${repo}" != "not found" ]]; then
                repo="https:/${repo#*/}"
                repo="${repo%%\",}"
            fi
            echo "  service: ${service}"
            echo "     path: ${path}"
            echo "     repo: ${repo}"
            if [[ "${status}" == "active" ]]; then
                echo "   status: ${GREEN}${status}${NORM}"
            else
                echo "   status: ${RED}${status}${NORM}"
            fi
        done <<< "${output}"
    done
}

