_gen_bash_completion() {
    cat << 'BASH_COMP'
# bash completion for incusmagic / im
_incusmagic_completions() {
    local cur prev words cword
    _init_completion || return

    local nouns="container profile network image launch list backup ssh storage port diag report ps remote customization start-over k8s find-actions docs reload completion version help"
    local noun_aliases="c p net img l ls b st d r rem cust"

    # Resolve alias to full noun
    _resolve_noun() {
        case "$1" in
            c) echo "container" ;;
            p) echo "profile" ;;
            net) echo "network" ;;
            img) echo "image" ;;
            l) echo "launch" ;;
            ls) echo "list" ;;
            b) echo "backup" ;;
            st) echo "storage" ;;
            d) echo "diag" ;;
            r) echo "report" ;;
            rem) echo "remote" ;;
            cust) echo "customization" ;;
            *) echo "$1" ;;
        esac
    }

    if [[ ${cword} -eq 1 ]]; then
        COMPREPLY=( $(compgen -W "${nouns} ${noun_aliases}" -- "${cur}") )
        return
    fi

    local noun
    noun=$(_resolve_noun "${words[1]}")

    if [[ ${cword} -eq 2 ]]; then
        local verbs=""
        case "${noun}" in
            container) verbs="start stop restart delete start-all stop-all restart-all delete-all set-memory set-cpu resize exec-all run-all destroy-relaunch" ;;
            profile) verbs="add remove add-multi remove-multi delete delete-all" ;;
            network) verbs="delete delete-all" ;;
            image) verbs="list delete delete-all" ;;
            launch) verbs="wizard recommended clone test" ;;
            list) verbs="wide narrow csv" ;;
            backup) verbs="all" ;;
            ssh) verbs="enable" ;;
            storage) verbs="move" ;;
            port) verbs="forward" ;;
            diag) verbs="top inotify disks systemd-udevd" ;;
            report) verbs="disks disksize" ;;
            ps) verbs="systemd tree find" ;;
            remote) verbs="install start get-pm" ;;
            customization) verbs="delete" ;;
            start-over) verbs="full active configs report" ;;
            k8s) verbs="cluster" ;;
            completion) verbs="bash zsh install" ;;
            help) verbs="${nouns}" ;;
        esac
        if [[ -n "${verbs}" ]]; then
            COMPREPLY=( $(compgen -W "${verbs}" -- "${cur}") )
            return
        fi
    fi

    # Dynamic completions for container/profile/network names
    local verb="${words[2]:-}"
    case "${noun}" in
        container)
            case "${verb}" in
                start|stop|restart|delete|set-memory|set-cpu|destroy-relaunch)
                    local containers
                    containers=$(incus list -c n -f csv 2>/dev/null | awk -F',' '{print $1}')
                    COMPREPLY=( $(compgen -W "${containers}" -- "${cur}") )
                    ;;
                resize)
                    if [[ ${cword} -eq 3 ]]; then
                        COMPREPLY=( $(compgen -W "disk memory cpu" -- "${cur}") )
                    else
                        local containers
                        containers=$(incus list -c n -f csv 2>/dev/null | awk -F',' '{print $1}')
                        COMPREPLY=( $(compgen -W "${containers}" -- "${cur}") )
                    fi
                    ;;
            esac
            ;;
        profile)
            case "${verb}" in
                add|remove|delete)
                    if [[ ${cword} -eq 3 ]]; then
                        local profiles
                        profiles=$(incus profile list -f csv 2>/dev/null | awk -F',' '{print $1}')
                        COMPREPLY=( $(compgen -W "${profiles}" -- "${cur}") )
                    else
                        local containers
                        containers=$(incus list -c n -f csv 2>/dev/null | awk -F',' '{print $1}')
                        COMPREPLY=( $(compgen -W "${containers}" -- "${cur}") )
                    fi
                    ;;
                add-multi|remove-multi)
                    if [[ ${cword} -eq 3 ]]; then
                        local containers
                        containers=$(incus list -c n -f csv 2>/dev/null | awk -F',' '{print $1}')
                        COMPREPLY=( $(compgen -W "${containers}" -- "${cur}") )
                    else
                        local profiles
                        profiles=$(incus profile list -f csv 2>/dev/null | awk -F',' '{print $1}')
                        COMPREPLY=( $(compgen -W "${profiles}" -- "${cur}") )
                    fi
                    ;;
            esac
            ;;
        network)
            local networks
            networks=$(incus network list -f csv 2>/dev/null | grep ',CREATED$' | awk -F',' '{print $1}')
            COMPREPLY=( $(compgen -W "${networks}" -- "${cur}") )
            ;;
        storage)
            if [[ ${cword} -eq 3 ]]; then
                local pools
                pools=$(incus storage list -f csv 2>/dev/null | awk -F',' '{print $1}')
                COMPREPLY=( $(compgen -W "${pools}" -- "${cur}") )
            else
                local containers
                containers=$(incus list -c n -f csv 2>/dev/null | awk -F',' '{print $1}')
                COMPREPLY=( $(compgen -W "${containers}" -- "${cur}") )
            fi
            ;;
        backup)
            local containers
            containers=$(incus list -c n -f csv 2>/dev/null | awk -F',' '{print $1}')
            COMPREPLY=( $(compgen -W "${containers}" -- "${cur}") )
            ;;
        customization)
            if [[ "${verb}" == "delete" && ${cword} -eq 3 ]]; then
                COMPREPLY=( $(compgen -W "profiles startcmds networks projects storage" -- "${cur}") )
            fi
            ;;
        report)
            if [[ "${verb}" == "disksize" && ${cword} -eq 3 ]]; then
                local pools
                pools=$(incus storage list -f csv 2>/dev/null | awk -F',' '{print $1}')
                COMPREPLY=( $(compgen -W "${pools}" -- "${cur}") )
            fi
            ;;
    esac
}
complete -F _incusmagic_completions incusmagic
complete -F _incusmagic_completions im
BASH_COMP
}

