# Storage pool resource helpers
_get_pool_space_used() {
    local pool="$1"
    local storageshow
    storageshow=$(incus storage show "${pool}" --resources)
    local spaceUsed
    spaceUsed=$(echo "${storageshow}" | grep "used:" | head -1 | awk '{print $2}')
    echo "scale=2; ${spaceUsed} / 1024 / 1024 / 1024" | bc
}
_get_pool_space_total() {
    local pool="$1"
    local storageshow
    storageshow=$(incus storage show "${pool}" --resources)
    local spaceTotal
    spaceTotal=$(echo "${storageshow}" | grep "total:" | head -1 | awk '{print $2}')
    echo "scale=2; ${spaceTotal} / 1024 / 1024 / 1024" | bc
}
_get_instance_storage_size() {
    local container="$1"
    local thisSize
    thisSize=$(incus config show "${container}" 2>&1 | grep "size:" | awk -F " " '{print $2}')
    if [[ -z "${thisSize}" ]]; then
        echo "10"
    else
        echo "${thisSize}" | sed 's/[^0-9.]//g'
    fi
}

# Cache for disk usage lookups
__disk_usage_cache=""
_cache_disk_usage() {
    __disk_usage_cache=$(incus list -c nD -f csv)
}
_get_instance_disk_usage() {
    local container="$1"
    local thisSize
    thisSize=$(echo "${__disk_usage_cache}" | grep "$1" | awk -F "," '{print $2}')
    if [[ -z "${thisSize}" ]]; then
        echo "stopped"
    else
        echo "${thisSize}" | sed 's/[^0-9.]//g'
    fi
}
_get_instance_disk_internal_size() {
    local container="$1"
    local output
    output=$(incus exec "${container}" -- df -h -x tmpfs -x devtmpfs -x squashfs -x efivarfs / 2>&1 | grep / | awk -F " " '{print $2}')
    if [[ -z "${output}" ]]; then echo "stopped"; else echo "${output}" | sed 's/[^0-9.]//g'; fi
}
_get_instance_disk_internal_used() {
    local container="$1"
    local output
    output=$(incus exec "${container}" -- df -h -x tmpfs -x devtmpfs -x squashfs -x efivarfs / 2>&1 | grep / | awk -F " " '{print $3}')
    if [[ -z "${output}" ]]; then echo "stopped"; else echo "${output}" | sed 's/[^0-9.]//g'; fi
}
_get_instance_disk_internal_avail() {
    local container="$1"
    local output
    output=$(incus exec "${container}" -- df -h -x tmpfs -x devtmpfs -x squashfs -x efivarfs / 2>&1 | grep / | awk -F " " '{print $4}')
    if [[ -z "${output}" ]]; then echo "stopped"; else echo "${output}" | sed 's/[^0-9.]//g'; fi
}
_get_instance_disk_dir_used() {
    local container="$1"
    local output
    output=$(sudo du -sh /var/lib/incus/containers/"${container}"/rootfs 2>/dev/null)
    if [[ -z "${output}" ]]; then echo "stopped"; else echo "${output}" | sed 's/[^0-9.]//g'; fi
}

_report_disksize_local() {
    local storagePool="$1"
    declare -a print_data
    local externalSpaceUsed externalSpaceTotal
    externalSpaceUsed=$(_get_pool_space_used "${storagePool}")
    externalSpaceTotal=$(_get_pool_space_total "${storagePool}")
    local container_names
    container_names=$(incus list -c nDsb -f csv | grep "${storagePool}" | awk -F "," '{print $1}' | xargs)
    IFS=" " read -r -a container_names_arr <<< "${container_names}"
    local fulldatasize fulldataavail
    fulldatasize=$(_get_instance_disk_internal_size "${container_names_arr[0]:-}" 2>/dev/null || echo "0")
    fulldataavail=$(_get_instance_disk_internal_avail "${container_names_arr[0]:-}" 2>/dev/null || echo "0")
    local Total_incus_data_allocated=0 Total_incus_data_used=0

    for cn in "${container_names_arr[@]}"; do
        local incus_data_allocated incus_data_used
        incus_data_allocated=$(_get_instance_storage_size "${cn}")
        incus_data_used=$(_get_instance_disk_dir_used "${cn}")
        Total_incus_data_allocated=$(echo "scale=2; ${Total_incus_data_allocated} + ${incus_data_allocated}" | bc)
        Total_incus_data_used=$(echo "scale=2; ${Total_incus_data_used} + ${incus_data_used}" | bc)
        local var="${cn},${incus_data_allocated},${incus_data_used},${fulldatasize},${fulldataavail}"
        print_data+=("${var}")
    done

    echo -e "\nStorage: ${storagePool} (${externalSpaceUsed} / ${externalSpaceTotal})\n"
    _printTable "," "justifyLeft,justifyRight,justifyRight,justifyRight,justifyRight" "20,15,15,15,15" "CONTAINER,I-ALLOC,I-DISK USED,DISK SIZE,DISK AVAIL" "Totals:,${Total_incus_data_allocated},${Total_incus_data_used},," print_data
    echo -e " - Column Headings"
    echo -e "   - I-ALLOC: Incus reported allocation when you set root size=xxx"
    echo -e "   - I-DISK USED: Incus reported disk usage (closely matches df -h inside the container)"
    echo -e "   - DISK SIZE: Size of the disk shared with the instances"
    echo -e "   - DISK AVAIL: Remaining space on the disk shared with the instances"
    echo -e " - all data is in GB\n"
}

_report_disksize_vg() {
    local VOLUMEGROUP="$1"
    declare -a containers
    declare -a print_data
    local externalSpaceUsed externalSpaceTotal
    externalSpaceUsed=$(_get_pool_space_used "${VOLUMEGROUP}")
    externalSpaceTotal=$(_get_pool_space_total "${VOLUMEGROUP}")
    local Total_incus_data_allocated=0 Total_lvm_data_used=0 Total_lvm_data_allocated=0 Total_incus_data_used=0
    _cache_disk_usage

    while IFS= read -r line; do
        local lv cn type data_used data_allocated data_percent incus_data_allocated incus_data_used
        lv=$(echo "${line}" | cut -d',' -f1)
        cn=$(echo "${lv}" | sed -e 's/containers_//' -e 's/virtual-machines_//' -e 's/--/-/g')
        cn=$(echo "${cn}" | xargs)
        containers+=("${cn}")
        type=$(echo "${lv}" | awk -F "_" '{print $1}' | xargs)
        data_used=$(echo "${line}" | cut -d',' -f2 | sed 's/[Gg]//')
        data_allocated=$(echo "${line}" | cut -d',' -f3 | sed 's/[Gg]//')
        data_percent=$(echo "${line}" | cut -d',' -f4)
        incus_data_allocated=$(_get_instance_storage_size "${cn}")
        incus_data_used=$(_get_instance_disk_usage "${cn}")
        [[ -z "${data_used}" ]] && data_used=0
        [[ -z "${data_allocated}" ]] && data_allocated=0
        [[ -z "${data_percent}" ]] && data_percent=0
        if [[ "${type}" != "IncusThinPool" ]]; then
            Total_incus_data_used=$(echo "${Total_incus_data_used} + ${incus_data_used}" | bc)
            Total_incus_data_allocated=$(echo "${Total_incus_data_allocated} + ${incus_data_allocated}" | bc)
            Total_lvm_data_used=$(echo "${Total_lvm_data_used} + ${data_used}" | bc)
            Total_lvm_data_allocated=$(echo "${Total_lvm_data_allocated} + ${data_allocated}" | bc)
        else
            incus_data_used=""
        fi
        local var="${cn},${lv},${incus_data_allocated},${incus_data_used},${data_allocated},${data_used},${data_percent}"
        print_data+=("${var}")
        if [[ "${type}" == "IncusThinPool" ]]; then
            print_data+=("-")
        fi
    done < <(sudo lvs --units g --noheadings --separator="," -o lv_name,data_percent,lv_size "${VOLUMEGROUP}" | awk -F, '{printf "%s,%s,%s,%s\n", $1, $3*$2/100, $3, $2}')

    echo -e "\nStorage: ${VOLUMEGROUP} (${externalSpaceUsed} / ${externalSpaceTotal})\n"
    _printTable "," "justifyLeft,justifyLeft,justifyRight,justifyRight,justifyRight,justifyRight,justifyRight" "20,50,15,15,15,15,15" "CONTAINER,LOGICAL VOLUME NAME,I-ALLOC,I-DISK USED,LV-SIZE,LVTP-ALLOC,LVTP-PERCENT" "Totals:,,${Total_incus_data_allocated},${Total_incus_data_used},${Total_lvm_data_allocated},${Total_lvm_data_used}," print_data
    echo -e " - Column Headings"
    echo -e "   - I-ALLOC: Incus reported allocation when you set root size=xxx"
    echo -e "   - I-DISK USED: Incus reported disk usage (closely matches df -h inside the container)"
    echo -e "   - LV-SIZE: Logical Volume size (assigned maximum size for the LV)"
    echo -e "   - LVTP-ALLOC: Logical Volume Thin Pool Allocation (amount the thinPool is using)"
    echo -e "   - LVTP-PERCENT: Amount of the Thin Pool currently committed against the LV-SIZE"
    echo -e " - all data is in GB\n"
}

