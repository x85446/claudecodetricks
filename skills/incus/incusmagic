main() {
    # Top-level options (must come before the noun). Recognized:
    #   --project=NAME / --project NAME / -P NAME   scope to an Incus project
    #   --remote=NAME  / --remote NAME  / -R NAME   default incus remote prefix
    #                                                applied to bare container names
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --project=*)
                INCUS_PROJECT="${1#--project=}"
                export INCUS_PROJECT
                shift
                ;;
            --project|-P)
                [[ $# -ge 2 ]] || _die "--project requires a value"
                INCUS_PROJECT="$2"
                export INCUS_PROJECT
                shift 2
                ;;
            --remote=*)
                INCUS_REMOTE="${1#--remote=}"
                export INCUS_REMOTE
                shift
                ;;
            --remote|-R)
                [[ $# -ge 2 ]] || _die "--remote requires a value"
                INCUS_REMOTE="$2"
                export INCUS_REMOTE
                shift 2
                ;;
            *)
                break
                ;;
        esac
    done

    [[ $# -eq 0 ]] && { _show_help; exit 0; }

    local noun="$1"; shift

    # Resolve noun aliases
    local _resolved
    _resolved=$(_resolve_noun_alias "${noun}")
    [[ -n "${_resolved}" ]] && noun="${_resolved}"

    case "${noun}" in
        # --- Top-level commands without a verb ---
        help)
            if [[ $# -gt 0 ]]; then
                _show_subcommand_help "$1"
            else
                _show_help
            fi
            ;;
        version)     echo "incusmagic v${VERSION}" ;;
        docs)        _cmd_docs "$@" ;;
        reload)      _cmd_reload "$@" ;;
        find-actions) _cmd_find_actions "$@" ;;
        history)     _cmd_history "$@" ;;

        # --- Two-level commands ---
        container)
            local verb="${1:-help}"; shift || true
            case "${verb}" in
                start)            _cmd_container_start "$@" ;;
                stop)             _cmd_container_stop "$@" ;;
                restart)          _cmd_container_restart "$@" ;;
                delete)           _cmd_container_delete "$@" ;;
                start-all)        _cmd_container_start_all "$@" ;;
                stop-all)         _cmd_container_stop_all "$@" ;;
                restart-all)      _cmd_container_restart_all "$@" ;;
                delete-all)       _cmd_container_delete_all "$@" ;;
                set-memory)       _cmd_container_set_memory "$@" ;;
                set-cpu)          _cmd_container_set_cpu "$@" ;;
                resize)           _cmd_container_resize "$@" ;;
                exec-all)         _cmd_container_exec_all "$@" ;;
                run-all)          _cmd_container_run_all "$@" ;;
                destroy-relaunch) _cmd_container_destroy_relaunch "$@" ;;
                help|--help|-h)   _show_subcommand_help container ;;
                *)                _die "Unknown container command: ${verb}. Run '${PROG} help container'" ;;
            esac
            ;;
        profile)
            local verb="${1:-help}"; shift || true
            case "${verb}" in
                add)          _cmd_profile_add "$@" ;;
                remove)       _cmd_profile_remove "$@" ;;
                add-multi)    _cmd_profile_add_multi "$@" ;;
                remove-multi) _cmd_profile_remove_multi "$@" ;;
                delete)       _cmd_profile_delete "$@" ;;
                delete-all)   _cmd_profile_delete_all "$@" ;;
                help|--help|-h) _show_subcommand_help profile ;;
                *)            _die "Unknown profile command: ${verb}. Run '${PROG} help profile'" ;;
            esac
            ;;
        network)
            local verb="${1:-help}"; shift || true
            case "${verb}" in
                delete)     _cmd_network_delete "$@" ;;
                delete-all) _cmd_network_delete_all "$@" ;;
                help|--help|-h) _show_subcommand_help network ;;
                *)          _die "Unknown network command: ${verb}. Run '${PROG} help network'" ;;
            esac
            ;;
        image)
            local verb="${1:-help}"; shift || true
            case "${verb}" in
                list)       _cmd_image_list "$@" ;;
                delete)     _cmd_image_delete "$@" ;;
                delete-all) _cmd_image_delete_all "$@" ;;
                help|--help|-h) _show_subcommand_help image ;;
                *)          _die "Unknown image command: ${verb}. Run '${PROG} help image'" ;;
            esac
            ;;
        launch)
            local verb="${1:-}"
            case "${verb}" in
                "")          _cmd_launch_wizard ;;
                recommended) shift; _cmd_launch_recommended "$@" ;;
                clone)       shift; _cmd_launch_clone "$@" ;;
                test)        shift; _cmd_launch_test "$@" ;;
                wizard)      shift; _cmd_launch_wizard "$@" ;;
                help|--help|-h) _show_subcommand_help launch ;;
                *)           _cmd_launch "$@" ;;
            esac
            ;;
        list)
            local verb="${1:-}"
            case "${verb}" in
                wide)    shift; _cmd_list_wide "$@" ;;
                narrow)  shift; _cmd_list_narrow "$@" ;;
                csv)     shift; _cmd_list_csv "$@" ;;
                help|--help|-h) _show_subcommand_help list ;;
                *)       _cmd_list "$@" ;;
            esac
            ;;
        backup)
            local verb="${1:-}"
            case "${verb}" in
                all)     shift; _cmd_backup_all "$@" ;;
                help|--help|-h) _show_subcommand_help backup ;;
                *)       _cmd_backup "$@" ;;
            esac
            ;;
        ssh)
            local verb="${1:-help}"; shift || true
            case "${verb}" in
                enable)  _cmd_ssh_enable "$@" ;;
                help|--help|-h) _show_subcommand_help ssh ;;
                *)       _die "Unknown ssh command: ${verb}. Run '${PROG} help ssh'" ;;
            esac
            ;;
        storage)
            local verb="${1:-help}"; shift || true
            case "${verb}" in
                move)    _cmd_storage_move "$@" ;;
                help|--help|-h) _show_subcommand_help storage ;;
                *)       _die "Unknown storage command: ${verb}. Run '${PROG} help storage'" ;;
            esac
            ;;
        port)
            local verb="${1:-help}"; shift || true
            case "${verb}" in
                forward) _cmd_port_forward "$@" ;;
                help|--help|-h) _show_subcommand_help port ;;
                *)       _die "Unknown port command: ${verb}. Run '${PROG} help port'" ;;
            esac
            ;;
        diag)
            local verb="${1:-help}"; shift || true
            case "${verb}" in
                top)          _cmd_diag_top "$@" ;;
                inotify)      _cmd_diag_inotify "$@" ;;
                disks)        _cmd_diag_disks "$@" ;;
                systemd-udevd) _cmd_diag_systemd_udevd "$@" ;;
                help|--help|-h) _show_subcommand_help diag ;;
                *)            _die "Unknown diag command: ${verb}. Run '${PROG} help diag'" ;;
            esac
            ;;
        report)
            local verb="${1:-help}"; shift || true
            case "${verb}" in
                disks)    _cmd_report_disks "$@" ;;
                disksize) _cmd_report_disksize "$@" ;;
                help|--help|-h) _show_subcommand_help report ;;
                *)        _die "Unknown report command: ${verb}. Run '${PROG} help report'" ;;
            esac
            ;;
        ps)
            local verb="${1:-help}"; shift || true
            case "${verb}" in
                systemd) _cmd_ps_systemd "$@" ;;
                tree)    _cmd_ps_tree "$@" ;;
                find)    _cmd_ps_find "$@" ;;
                help|--help|-h) _show_subcommand_help ps ;;
                *)       _die "Unknown ps command: ${verb}. Run '${PROG} help ps'" ;;
            esac
            ;;
        remote)
            local verb="${1:-help}"; shift || true
            case "${verb}" in
                install) _cmd_remote_install "$@" ;;
                start)   _cmd_remote_start "$@" ;;
                get-pm)  _cmd_remote_get_pm "$@" ;;
                help|--help|-h) _show_subcommand_help remote ;;
                *)       _die "Unknown remote command: ${verb}. Run '${PROG} help remote'" ;;
            esac
            ;;
        customization)
            local verb="${1:-help}"; shift || true
            case "${verb}" in
                delete)  _cmd_customization_delete "$@" ;;
                help|--help|-h) _show_subcommand_help customization ;;
                *)       _die "Unknown customization command: ${verb}. Run '${PROG} help customization'" ;;
            esac
            ;;
        start-over)
            local verb="${1:-help}"; shift || true
            case "${verb}" in
                full)    _cmd_start_over_full "$@" ;;
                active)  _cmd_start_over_active "$@" ;;
                configs) _cmd_start_over_configs "$@" ;;
                report)  _cmd_start_over_report "$@" ;;
                help|--help|-h) _show_subcommand_help start-over ;;
                *)       _die "Unknown start-over command: ${verb}. Run '${PROG} help start-over'" ;;
            esac
            ;;
        k8s)
            local verb="${1:-help}"; shift || true
            case "${verb}" in
                cluster) _cmd_k8s_cluster "$@" ;;
                help|--help|-h) _show_subcommand_help k8s ;;
                *)       _die "Unknown k8s command: ${verb}. Run '${PROG} help k8s'" ;;
            esac
            ;;
        completion)
            local verb="${1:-help}"; shift || true
            case "${verb}" in
                bash)    _gen_bash_completion ;;
                zsh)     _gen_zsh_completion ;;
                install) _install_completions ;;
                help|--help|-h) _show_subcommand_help completion ;;
                *)       _die "Unknown completion command: ${verb}. Run '${PROG} help completion'" ;;
            esac
            ;;
        --help|-h) _show_help ;;
        --version|-v) echo "incusmagic v${VERSION}" ;;
        *)
            _die "Unknown command: ${noun}. Run '${PROG} help' for usage."
            ;;
    esac
}

# ============================================================
# 7. Entry Point
# ============================================================

main "$@"
