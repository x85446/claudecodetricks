        "link": "deel",
        "sublink_prefix": "D",
        "type": "ACH_DEBIT"
      },
      "children": {
        "salaries": {
          "details": "SPLIT",
          "site_pattern": "deel.{employee}",
          "type": "EMPLOYEE_SALARY",
          "acrual_rule": "end_of_month"
        },
        "fees": {
          "details": "SPLIT",
          "site": "deel.fee",
          "type": "Fee",
          "acrual_rule": "end_of_month"
        }
      },
      "employees": ["pete", "jenia", "janne", "gabi", "eran"],
      "sublink_has_period": {
        "parent": false,
        "children": true
      }
    },
    "onpay": {
