  "split_rules": {
    "posting_date": "Children inherit parent's posting date (column C)",
    "sublink_parent": "Format: [Prefix][YYMM] without period",
    "sublink_child": "Format: [Prefix][YYMM]. with period",
    "validation": "Sum of child Split Valid (P) must equal negated parent Amount (E)",
